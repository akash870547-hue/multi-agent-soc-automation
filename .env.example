# Optional API protection
SOC_API_KEY=
# Optional role-specific keys. If configured, these enable RBAC.
SOC_ANALYST_KEY=
SOC_RESPONDER_KEY=
SOC_ADMIN_KEY=

# Reasoning provider: deterministic (default) or openai
SOC_REASONING_PROVIDER=deterministic
SOC_REASONING_MODEL=gpt-5.6-luna
OPENAI_API_KEY=\n\n# Optional VirusTotal threat-intelligence enrichment\nVIRUSTOTAL_API_KEY=

# Optional SQLite location
SOC_DB_PATH=soc_automation.db

# API abuse protection
SOC_RATE_LIMIT=60
SOC_RATE_WINDOW_SECONDS=60


# Public one-time website test abuse protection
SOC_PUBLIC_TEST_RATE_LIMIT=10
SOC_PUBLIC_TEST_RATE_WINDOW_SECONDS=60
